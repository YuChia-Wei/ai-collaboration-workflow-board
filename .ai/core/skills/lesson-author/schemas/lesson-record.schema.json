{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lesson candidate record 1.0.0",
  "description": "Structural contract only; times, filename, authority and write semantics remain tool-owned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "owner",
    "id",
    "status",
    "created_at",
    "updated_at",
    "title",
    "observation",
    "evidence",
    "conclusion",
    "applies_when",
    "does_not_apply_when",
    "confidence",
    "follow_up"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "lesson"
    },
    "owner": {
      "const": "project"
    },
    "id": {
      "type": "string",
      "pattern": "^lesson-[0-9a-f]{32}$"
    },
    "status": {
      "const": "candidate"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "observation": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "note"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "conclusion": {
      "type": "string",
      "minLength": 1
    },
    "applies_when": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "does_not_apply_when": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "enum": [
        "tentative",
        "supported"
      ]
    },
    "follow_up": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "confidence": {
            "const": "supported"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
